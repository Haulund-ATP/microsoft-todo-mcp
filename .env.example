# ---------------------------------------------------------------------------
# microsoft-todo-mcp — environment variables
# Copy to .env for local development. NEVER commit a filled-in .env file.
# In Azure, these are supplied via Container Apps secrets / env vars backed by
# Key Vault references + managed identity — this file is for local dev only.
# ---------------------------------------------------------------------------

# --- Public identity of this deployment -------------------------------------
# Base URL at which this MCP server is reachable (used as OAuth issuer/audience,
# redirect URI construction, and Protected Resource Metadata "resource").
PUBLIC_BASE_URL=https://todo.h-aa.dk

# --- Upstream Microsoft Entra ID app registration (Graph / Tasks.ReadWrite) --
# Multi-tenant + personal Microsoft accounts app registration.
AZURE_TENANT_ID=replace-me
AZURE_CLIENT_ID=replace-me
# Client secret is NOT read from here in production (Key Vault); only used
# for local dev if you are not using a certificate credential.
AZURE_CLIENT_SECRET=replace-me

# --- Azure Key Vault ---------------------------------------------------------
AZURE_KEY_VAULT_URI=https://replace-me.vault.azure.net/

# --- Azure Storage (Table + Blob) -------------------------------------------
# Prefer managed identity in Azure; for local dev use Azurite or a connection
# string kept out of source control.
AZURE_STORAGE_ACCOUNT_NAME=replace-me
AZURE_STORAGE_CONNECTION_STRING=replace-me

# --- MCP-side OAuth 2.1 authorization server ---------------------------------
# Symmetric/asymmetric signing key material is generated at provisioning time
# and stored in Key Vault; MCP_OAUTH_SIGNING_KEY_NAME is the Key Vault secret
# name that holds the current JWK (private key, JSON).
MCP_OAUTH_SIGNING_KEY_NAME=replace-me
MCP_OAUTH_ISSUER=https://todo.h-aa.dk
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_AUTH_CODE_TTL_SECONDS=120

# --- Admin / owner identity ---------------------------------------------------
# Stable identity claim (Microsoft account "oid" or "sub", NOT email) that is
# allowed to use the /accounts admin page. Populated after first login; see
# docs/operations.md.
ADMIN_OWNER_CLAIM_NAME=oid
ADMIN_OWNER_CLAIM_VALUE=replace-me

# --- Cookies / sessions -------------------------------------------------------
SESSION_COOKIE_SECRET=replace-me
CSRF_COOKIE_SECRET=replace-me

# --- Misc ---------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
DEFAULT_TIMEZONE=Europe/Copenhagen
