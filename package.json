{
  "name": "microsoft-todo-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server for Microsoft To Do, usable as a custom connector in ChatGPT and Claude. Multi-account, multi-profile, backed by Azure Table/Blob Storage and Key Vault.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live-checklist": "tsx scripts/live-checklist-test.ts",
    "docker:build": "docker build -t microsoft-todo-mcp .",
    "prepare": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.0",
    "@azure/storage-blob": "^12.26.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@azure/identity": "^4.13.2",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@azure/msal-node": "^5.6.0",
    "jose": "^5.9.6",
    "express": "^4.21.2",
    "cookie-signature": "^1.2.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/express": "^4.17.21",
    "@types/cookie-parser": "^1.4.8",
    "@types/cookie-signature": "^1.1.2",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
